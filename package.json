{
  "name": "dojin-progress",
  "productName": "SyurabaBooster",
  "version": "0.1.0",
  "private": true,
  "description": "同人・マンガ作家のための、進捗が楽しくなるブースター",
  "author": "kafui-133",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bridge": "node bridge/index.mjs",
    "bridge:sim": "node bridge/index.mjs --simulate",
    "dev:crista": "concurrently -n app,bridge -c magenta,cyan \"next dev\" \"node bridge/index.mjs\"",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "framer-motion": "^14.0.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "koffi": "^3.3.2",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "io.github.kafui133.syurababooster",
    "productName": "SyurabaBooster",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/sounds/*.mp3",
      "electron/**/*",
      "bridge/core.mjs",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "electron/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SyurabaBooster-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "SyurabaBooster-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "進捗ブースター",
      "uninstallDisplayName": "進捗ブースター"
    }
  }
}
